# Copy to .env.local for local development (an empty base path is correct
# for local dev — leave it blank).
#
# In CI, the deploy workflow sets this to "/<repo-name>" so the static export
# resolves correctly under the GitHub Pages project URL
# (https://<user>.github.io/<repo-name>/).
NEXT_PUBLIC_BASE_PATH=

# Sanity project (public identifiers, not secrets). In CI these come from the
# deploy workflow (.github/workflows/deploy.yml).
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
